APP_ENV=development
DATABASE_URL=sqlite:///./swasthiq_eod.db
# Run `python3 -m alembic upgrade head` after changing DATABASE_URL for local file-backed databases.
CORS_ORIGINS=http://localhost:5173
MAX_RECORDS_PER_REQUEST=10000
MAX_REQUEST_BODY_BYTES=5242880
STORE_REJECTED_RAW_ROWS=false

# Narrative provider. With no key, a fully traced deterministic fallback is used.
LLM_ENABLED=true
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
# Leave blank to use NVIDIA hosted API Catalog defaults. Set for a compatible self-hosted NIM endpoint.
NVIDIA_BASE_URL=
LLM_TIMEOUT_SECONDS=25
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0
LLM_TRANSPORT_RETRIES=1
