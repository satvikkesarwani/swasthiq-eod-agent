APP_ENV=development
DATABASE_URL=sqlite:///./swasthiq_eod.db
# Run `python3 -m alembic upgrade head` after changing DATABASE_URL for local file-backed databases.
CORS_ORIGINS=http://localhost:5173
MAX_RECORDS_PER_REQUEST=10000
MAX_REQUEST_BODY_BYTES=5242880
STORE_REJECTED_RAW_ROWS=false

# Narrative provider. With no key, a fully traced deterministic fallback is used.
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
LLM_TIMEOUT_SECONDS=20
