APP_ENV=development
APP_VERSION=1.0.0
DATABASE_URL=sqlite:///./swasthiq_eod.db
# Run `python3 -m alembic upgrade head` after changing DATABASE_URL for local file-backed databases.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_INCLUDE_REQUEST_ID=true
MAX_RECORDS_PER_REQUEST=10000
MAX_REQUEST_BODY_BYTES=5242880
STORE_REJECTED_RAW_ROWS=false
NARRATIVE_RATE_LIMIT_PER_MINUTE=12

# Narrative provider. With no key, a fully traced deterministic fallback is used.
LLM_ENABLED=true
LLM_PROVIDER=nvidia
# Preferred when multiple NVIDIA keys are available. One key is selected per provider call.
NVIDIA_API_KEYS=
# Backward-compatible single-key option. Ignored when NVIDIA_API_KEYS is populated.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
# Leave blank to use NVIDIA hosted API Catalog defaults. Set for a compatible self-hosted NIM endpoint.
NVIDIA_BASE_URL=
LLM_TIMEOUT_SECONDS=25
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0
LLM_TRANSPORT_RETRIES=1
